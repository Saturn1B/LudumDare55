  quickMenu: {fileID: 1327870457}
  tooltipsOption: {fileID: 679983812}
  activatorSubtitle: '- Activator Editor -'
  activatorExplanation: '- The <color=yellow>Activator Editor</color> lets you see
    and edit what an <color=yellow>Activator</color> will trigger.


    - When in
    the editor click on an <color=yellow>Activable Object</color> to add it to the
    list of object an <color=yellow>Activator</color> will trigger when interacted
    with.


    - You can remove an <color=yellow>Activable</color> from the trigger
    list by clicking the <color=red>X</color> next to the <color=yellow>Activable</color>
    name.


    - You can highligh an <color=yellow>Activable</color> linked by clicking
    on the <color=yellow>Activable</color> name in the list.


    - Once you have
    finished, simply click on <color=yellow>Accept</color> to validate your choice
    and close the editor.'
  activableSubtitle: '- Activable Viewer -'
  activableExplanation: '- The <color=yellow>Activable Viewer</color> lets you see
    what an <color=yellow>Activable</color> will be triggered from.


    - You can
    highligh the <color=yellow>Activator</color> it is linked to by clicking on the
    <color=yellow>Activator</color> name in the list.


    - Once you have finished,
    simply click on <color=yellow>Accept</color> to close the viewer.'
  dispenserPanel: {fileID: 160169101}
  typeDropdown: {fileID: 692919979}
  numberDropdown: {fileID: 1640702628}
